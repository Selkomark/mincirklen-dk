# Dependencies and build output
node_modules/
dist/
dist-docs/
coverage/

# Locally-generated TLS certs/keys (./setup-local-certs.sh) — machine-specific,
# signed by that machine's own mkcert CA. Never commit private key material.
local-infra/caddy/certs/

# Generated by setup-local-dns.sh — this machine's current LAN IP baked in
# as the DNS answer. Machine- and network-specific, regenerate by re-running
# the script rather than committing a snapshot.
local-infra/dns/dnsmasq.conf

.DS_Store

services/web-app/service-accounts/*

# Generated by setup-oauth-env.sh from the gitignored Google OAuth client
# JSON above — never commit real client secrets.
/.env
