    "@mincirklen/proto": "workspace:*",
    "@mincirklen/shared": "workspace:*",
    "@sentry/bun": "^10.73.0",
    "@sentry/hono": "^10.73.0",
    "fastify": "^5.12.1",
    "hono": "^4.6.0",
    "ioredis": "^5.4.1",
    "kysely": "^0.28.0",
    "msgpackr": "^2.1.0",
    "nats": "^2.29.1"
